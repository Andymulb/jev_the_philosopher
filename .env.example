# Copy to .env and fill in your key. .env is git-ignored.
OPENROUTER_API_KEY=

# OpenAI-compatible endpoint OpenRouter exposes (chat models; NOT used for Jev)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Jev is a decision model and is served on OpenRouter's Decisions endpoint (see docs/jev-api.md)
JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions

# OpenRouter model slug
JEV_MODEL=typesafe/jev-1.13
